# Server Configuration
PORT=3000
NODE_ENV=development

# Database
DB_PATH=./data/email_platform.db

# Email Configuration
DEFAULT_FROM_NAME=Your Company
DEFAULT_FROM_EMAIL=noreply@yourcompany.com

# Rate Limiting (emails per minute per account)
RATE_LIMIT_PER_MINUTE=60

# LARK SMTP Configuration Examples
# Account 1
LARK_SMTP_HOST_1=smtp.larksuite.com
LARK_SMTP_PORT_1=587
LARK_SMTP_USER_1=your-email-1@yourcompany.com
LARK_SMTP_PASS_1=your-app-password-1

# Account 2
LARK_SMTP_HOST_2=smtp.larksuite.com
LARK_SMTP_PORT_2=587
LARK_SMTP_USER_2=your-email-2@yourcompany.com
LARK_SMTP_PASS_2=your-app-password-2

# Add more accounts as needed...
